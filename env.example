# =============================================================================
# Document Extractor API — Variables de entorno
# =============================================================================
# Copiar a .env y ajustar valores. En producción NUNCA commitear .env
# Local:  cp env.example .env
# Producción: definir en el host o usar env_file en docker-compose
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Desarrollo local (PostgreSQL en Docker o local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/document_extractor
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/document_extractor_test
# Fallback si no hay PostgreSQL (tests, desarrollo mínimo)
DATABASE_URL_FALLBACK=sqlite:///./data/documents.db

# -----------------------------------------------------------------------------
# Redis (cache y colas RQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8005

# -----------------------------------------------------------------------------
# Seguridad (OBLIGATORIO en producción: cambiar y no usar valor por defecto)
# -----------------------------------------------------------------------------
SECRET_KEY=local-development-key-change-in-production-32-chars-minimum-required

# CORS (en producción usar orígenes concretos, ej: https://mi-app.com)
# CORS_ORIGINS=*
# RATE_LIMIT_ENABLED=True
# RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# OCR / APIs externas (opcional)
# -----------------------------------------------------------------------------
# TESSERACT_CMD=
# GOOGLE_APPLICATION_CREDENTIALS=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Producción (ejemplo; usar secrets en el host)
# -----------------------------------------------------------------------------
# ENVIRONMENT=production
# DEBUG=False
# DATABASE_URL=postgresql://user:pass@postgres:5432/document_extractor
# REDIS_URL=redis://redis:6379
# SECRET_KEY=<generar-clave-segura-32-chars-minimo>
# CORS_ORIGINS=https://tu-dominio.com
