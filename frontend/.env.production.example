# Frontend — Producción (build con estas variables)
# Copiar a .env.production antes de: npm run build
# Si el frontend se sirve con el mismo nginx que hace proxy a /api, usar base URL vacía.

# API en el mismo origen (nginx hace proxy de /api a backend)
REACT_APP_API_URL=

# O si la API está en otro dominio:
# REACT_APP_API_URL=https://api.tu-dominio.com

# Reducir tamaño del build (opcional)
GENERATE_SOURCEMAP=false
